---
layout: base
title: Library Item
description: ""
---


{% render 'blocks/navbar.liquid' page:page %}
<main>

<div class="headline region wrapper">
    <div class="content flow">
        <h1>{{title}}</h1>
        <p>{{description}}</p>
        <ul>
        </ul>
        <ul class="cluster">
            <li>Rating: {{ rating }}</li>
            <li>Status: {{ status }}</li>
            <li>Time: {{ time }}</li>
            <li>Review Date: {{date | date: "%Y-%m-%d" }}</li>
        </ul>
    </div>
</div>
<div>
 
</div>
<div class="wrapper flow" style="--wrapper-max-width: var(--measurexl);">
  {{ content }}
<img src="{{ image }}" alt="{{ imgalt }}">
</div>

</main>