{
  "color": {
    "$type": "color",
    
    "primary": {
      "$value": "{color.purple.100}"
    },

    "accent": {
      "$value": "{color.purple.600}"
    },

    "canvas": {
      "$value": "{color.gray.100}"
    },

    "border": {
      "$value": "{color.neutral.700}"
    },

    "light": {
      "$value": "{color.neutral.100}"
    },

    "dark": {
      "$value": "{color.neutral.900}"
    },

    "text": {
      "normal": {
        "$value": "{color.dark}"
      },
      "quiet": {
        "$value": "{color.neutral.600}"
      },
      "quieter": {
        "$value": "{color.neutral.500}"
      },
      "placeholder": {
        "$value": "{color.neutral.500}"
      },
      "link": {
        "$value": "{color.text.normal}"
      }
    },

    "success": {
            "fill": {
        "quiet": {
          "$value": "{color.emerald.50}"
        },
        "normal": {
          "$value": "{color.emerald.100}"
        },
        "loud": {
          "$value": "{color.emerald.600}"
        }
      },
      "on": {
        "quiet": {
          "$value": "{color.emerald.700}"
        },
        "normal": {
          "$value": "{color.emerald.700}"
        },
        "loud": {
          "$value": "{color.emerald.50}"
        }
      }
    },

    "warning": {
      "fill": {
        "quiet": {
          "$value": "{color.amber.50}"
        },
        "normal": {
          "$value": "{color.amber.100}"
        },
        "loud": {
          "$value": "{color.amber.600}"
        }
      },
      "on": {
        "quiet": {
          "$value": "{color.amber.700}"
        },
        "normal": {
          "$value": "{color.amber.700}"
        },
        "loud": {
          "$value": "{color.amber.50}"
        }
      }
    },

    "error": {
      "fill": {
        "quiet": {
          "$value": "{color.rose.50}"
        },
        "normal": {
          "$value": "{color.rose.100}"
        },
        "loud": {
          "$value": "{color.rose.600}"
        }
      },
      "on": {
        "quiet": {
          "$value": "{color.rose.700}"
        },
        "normal": {
          "$value": "{color.rose.700}"
        },
        "loud": {
          "$value": "{color.rose.50}"
        }
      }
    },

    "info": {
      "fill": {
        "quiet": {
          "$value": "{color.blue.50}"
        },
        "normal": {
          "$value": "{color.blue.100}"
        },
        "loud": {
          "$value": "{color.blue.600}"
        }
      },
      "on": {
        "quiet": {
          "$value": "{color.blue.700}"
        },
        "normal": {
          "$value": "{color.blue.700}"
        },
        "loud": {
          "$value": "{color.blue.50}"
        }
      }
    },

    "selection": {
      "background":{
        "$value": "{color.accent}"
      },
      "text": { 
        "$value": "{color.light}" 
      }
    }
  }
}